# === Telegram ===

# Токен бота от @BotFather (обязательно)
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Твой Telegram ID — станешь старостой. Узнать: @userinfobot
ROOT_USER_IDS=123456789

# Дополнительные администраторы и профорги (через запятую, можно пусто)
ADMIN_USER_IDS=
PROFORG_USER_IDS=

# === Мини-приложение ===

# Публичный HTTPS-адрес. Бот сам поставит кнопку «Приложение» в меню.
# Для локальной разработки: cloudflared tunnel --url http://localhost:8080
WEBAPP_URL=https://example.trycloudflare.com

# === Админ-панель ===

# Пароль для входа в панель (придумай сложный)
ADMIN_PASSWORD=change_me

# true — панель отвечает только с localhost (безопасно)
ADMIN_ADDR=127.0.0.1:8081
ADMIN_ONLY_LOCAL=true

# === Сеть ===

# Веб-сервер мини-приложения
LISTEN_ADDR=:8080

# Прокси для Telegram API. Пусто — бот возьмёт системный прокси Windows.
# PROXY_URL=http://127.0.0.1:7890
PROXY_URL=

# === Хранилище ===

DB_PATH=data/studbot.db
UPLOAD_DIR=data/uploads
EXPORT_DIR=data/exports